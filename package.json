{
    "name": "manager-lms-mini-frontend",
    "version": "2.0.0",
    "description": "Vue 2 frontend for Manager LMS Mini",
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "lint-fix": "eslint --fix .",
        "format": "prettier --write src index.html vite.config.js eslint.config.js",
        "check": "npm run lint && npm run build"
    },
    "dependencies": {
        "axios": "1.17.0",
        "element-ui": "2.15.14",
        "nprogress": "0.2.0",
        "vue": "2.7.16",
        "vue-i18n": "^8.28.2",
        "vue-router": "3.6.5"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@vitejs/plugin-vue2": "2.3.4",
        "eslint": "10.2.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.5",
        "eslint-plugin-vue": "10.9.0",
        "globals": "17.5.0",
        "prettier": "3.8.3",
        "sass": "1.99.0",
        "vite": "7.2.4"
    }
}
